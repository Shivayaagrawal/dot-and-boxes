# Copy to ".env" in the project root, then: docker compose --env-file .env up -d --build
# Never commit a real .env (secrets).

# API (container must listen on 8484; Caddy proxies to this)
PORT=8484

# Postgres: either DATABASE_URL (recommended for Render/Heroku-style hosts) or discrete vars below.
# When DATABASE_URL is set, it wins; DATABASE_SSLMODE is applied only if the URL has no sslmode=.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Compose / local discrete vars (service name is "db")
DATABASETYPE=postgres
DATABASEUSER=postgres
DATABASEPASSWORD=postgres
POSTGRES_DB=dnboxes
DATABASEHOST=db
DATABASEPORT=5432
# Local Docker Postgres: omit or use disable. Render / most clouds: require
# DATABASE_SSLMODE=require

# Redis — local: REDIS_ADDR=127.0.0.1:6379 + REDIS_PASSWORD if needed (integration tests use DB 1)
# Upstash (TLS): REDIS_ADDR=rediss://default:PASSWORD@endpoint.upstash.io:6379 — same URL works for `go test`
# Tests load .env via internal/testutil; remote cleanup deletes lobby:* only (not FLUSHDB).
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# JWT signing (use a long random string in production)
TOKEN_KEY=change-me-to-a-long-random-secret-for-local-dev-only

# Browser origin(s) for CORS + CSRF cookie mode (comma-separated for multiple, e.g. Vite + Docker UI).
# Manual dev: match Vite exactly — http://localhost:5173
# Compose + Caddy on :8080: add both, e.g. CLIENT_ORIGIN=http://localhost:5173,http://localhost:8080
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
